# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# spec-kit scaffold. Never initialised here: the tree was a husk with no
# memory/, templates/ or scripts/, and every speckit prompt depends on them.
# Ignored so a partial `specify init` cannot creep into a commit. `docs/specs/`
# is this repo's spec system.
/.specify/
.conductor/

# Handovers pass context between local sessions and agents. They describe work
# in flight, not the repository's history, and are stale the moment the work
# lands — so they stay on the machine that wrote them.
.agents/handovers/
